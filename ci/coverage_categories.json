{
  "_doc": "Coverage categories. 'cpp' entries are gcovr --filter regexes (relative to the repo root), 'python' entries are coverage.py --include globs. A category may list both; its percentage is then covered/total lines summed over both languages. 'id' is the badge file name (badges/<id>.json).",
  "cpp_exclude": [
    "(.+/)?tests/",
    "(.+/)?subprojects/"
  ],
  "python_omit": [
    "tests/*",
    "*/tests/*"
  ],
  "categories": [
    {
      "id": "pam",
      "label": "PAM",
      "cpp": [
        "secureEye/src/pam/"
      ]
    },
    {
      "id": "daemon",
      "label": "Daemon",
      "python": [
        "secureEye/src/authd/*"
      ]
    },
    {
      "id": "core",
      "label": "Core",
      "python": [
        "secureEye/src/auth/*",
        "secureEye/src/detectors/*",
        "secureEye/src/recorders/*",
        "secureEye/src/rubberstamps/*",
        "secureEye/src/compare.py",
        "secureEye/src/dlib_models.py",
        "secureEye/src/i18n.py",
        "secureEye/src/paths_factory.py",
        "secureEye/src/snapshot.py"
      ]
    },
    {
      "id": "cli",
      "label": "CLI",
      "python": [
        "secureEye/src/cli/*",
        "secureEye/src/cli.py"
      ]
    },
    {
      "id": "gui",
      "label": "GUI",
      "cpp": [
        "secureEye/src/gui/"
      ]
    }
  ]
}
