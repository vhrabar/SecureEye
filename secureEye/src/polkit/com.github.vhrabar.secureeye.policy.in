<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  pkexec picks the action by the program path and its first argument, so every
  secureEye command the GUI runs gets its own action. Commands without one fall
  back to org.freedesktop.policykit.exec, which always asks.
-->
<policyconfig>
  <vendor>SecureEye</vendor>
  <vendor_url>https://github.com/vhrabar/SecureEye</vendor_url>
  <icon_name>secureeye</icon_name>

  <action id="com.github.vhrabar.secureeye.models.list">
    <description>List enrolled face models</description>
    <message>Authentication is required to list your enrolled face models</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@cli_path@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">list</annotate>
  </action>

  <action id="com.github.vhrabar.secureeye.models.add">
    <description>Enroll a face model</description>
    <message>Authentication is required to enroll a new face model</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@cli_path@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">add</annotate>
  </action>

  <action id="com.github.vhrabar.secureeye.models.remove">
    <description>Remove a face model</description>
    <message>Authentication is required to remove a face model</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@cli_path@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">remove</annotate>
  </action>

  <action id="com.github.vhrabar.secureeye.models.clear">
    <description>Remove all face models</description>
    <message>Authentication is required to remove all of your face models</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@cli_path@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">clear</annotate>
  </action>

  <action id="com.github.vhrabar.secureeye.config.set">
    <description>Change the SecureEye configuration</description>
    <message>Authentication is required to change the SecureEye configuration</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@cli_path@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set</annotate>
  </action>

  <action id="com.github.vhrabar.secureeye.disable">
    <description>Enable or disable SecureEye</description>
    <message>Authentication is required to enable or disable SecureEye face authentication</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@cli_path@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">disable</annotate>
  </action>
</policyconfig>
