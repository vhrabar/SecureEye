# Settings for the Docker PAM tests (docker-compose.yml, profile "pam").
# Copy to .env and adjust; Compose loads .env automatically. .env is gitignored.

# Host camera passed into the container.
SECUREEYE_VIDEO_DEVICE=/dev/video2

# Camera path written to the config inside the container (defaults to SECUREEYE_VIDEO_DEVICE).
# SECUREEYE_DEVICE=/dev/video2

# Throwaway test user created inside the container.
SECUREEYE_USER=test_user
SECUREEYE_PASS=test_user

# smoke | full | interactive
PAM_FLOW=smoke

# PAM service the smoke test patches and authenticates against.
PAM_SERVICE=sudo
